rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------
    // Helpers
    // ---------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Transition-safe admin:
    // 1) Primary: Custom claims (request.auth.token.admin == true)
    // 2) Fallback: users/{uid}.role == "admin"  (keep only during migration)
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.admin == true) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
        )
      );
    }

    function isTimestamp(x) {
      return x is timestamp;
    }

    // ---------------------------
    // USERS (private)
    // ---------------------------
    match /users/{userId} {

      // Privacy: do NOT allow listing all users
      // (If you later need admin listing, change to: allow list: if isAdmin(); )
      allow list: if false;

      // Only owner or admin can read user doc
      allow get: if isOwner(userId) || isAdmin();

      // Create:
      // - user can only create their own doc id (userId == auth.uid)
      // - uid field must match auth.uid
      // - role field MUST NOT be provided by client
      // - admin can create any doc but uid must match doc id
      allow create: if (
                      isAuthenticated()
                      && userId == request.auth.uid
                      && request.resource.data.uid == request.auth.uid
                      && !('role' in request.resource.data)
                    )
                    || (
                      isAdmin()
                      && request.resource.data.uid == userId
                    );

      // Update:
      // - owner can update own doc
      // - uid must remain unchanged
      // - role must remain unchanged (prevents privilege escalation)
      // - admin can update any doc but must keep uid stable
      allow update: if (
                      isOwner(userId)
                      && request.resource.data.uid == resource.data.uid
                      && request.resource.data.role == resource.data.role
                    )
                    || (
                      isAdmin()
                      && request.resource.data.uid == resource.data.uid
                    );

      // Delete: owner or admin (istersen sadece admin yapabiliriz)
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Allow per-user subcollections safely (only under the user's own doc)
    // Example: /users/{uid}/favorites/*  or /users/{uid}/collections/*
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ---------------------------
    // PLACES
    // ---------------------------
    match /places/{placeId} {
      // Public read (change to isAuthenticated() if you want)
      allow read: if true;

      // Only admin can write
      allow create, update, delete: if isAdmin();
    }

    // ---------------------------
    // REVIEWS (top-level)
    // ---------------------------
    match /reviews/{reviewId} {
      // Public read (change to isAuthenticated() if you want)
      allow read: if true;

      // Create:
      // - must be authed
      // - must own review via userId
      // - createdAt must be a timestamp and not in the future
      // - rating must be 1..5
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid
                    && isTimestamp(request.resource.data.createdAt)
                    && request.resource.data.createdAt <= request.time
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;

      // Update/Delete:
      // - owner or admin
      // - userId cannot change
      allow update: if (isAdmin())
                    || (
                      isAuthenticated()
                      && resource.data.userId == request.auth.uid
                      && request.resource.data.userId == resource.data.userId
                    );

      allow delete: if (isAdmin())
                    || (
                      isAuthenticated()
                      && resource.data.userId == request.auth.uid
                    );
    }

    // ---------------------------
    // FAVORITES (top-level, if used)
    // ---------------------------
    match /favorites/{favId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;

      allow update, delete: if isAuthenticated()
                            && (
                              resource.data.userId == request.auth.uid
                              || isAdmin()
                            );
    }

    // ---------------------------
    // COLLECTIONS (top-level, if used)
    // ---------------------------
    match /collections/{collectionId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;

      allow update, delete: if isAuthenticated()
                            && (
                              resource.data.userId == request.auth.uid
                              || isAdmin()
                            );

      match /items/{itemId} {
        allow read: if isAuthenticated();

        allow create: if isAuthenticated()
                      && request.resource.data.userId == request.auth.uid;

        allow update, delete: if isAuthenticated()
                              && (
                                resource.data.userId == request.auth.uid
                                || isAdmin()
                              );
      }
    }

    // ---------------------------
    // DEFAULT DENY
    // ---------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
