rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------
    // Helpers
    // ---------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Claim-based admin ONLY (safe property access)
    function isAdminClaim() {
      return isAuthenticated()
        && ('admin' in request.auth.token)
        && request.auth.token.admin == true;
    }

    // Transition-safe admin (fallback only during migration)
    function isAdmin() {
      return isAdminClaim() || (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
      );
    }

    function isTimestamp(x) {
      return x is timestamp;
    }

    // Safe "role unchanged" check (avoids undefined/property errors)
    function roleUnchanged() {
      return (('role' in resource.data) == ('role' in request.resource.data)) &&
             (!('role' in resource.data) || request.resource.data.role == resource.data.role);
    }

    // ---------------------------
    // USERS (private)
    // ---------------------------
    match /users/{userId} {

      allow list: if false;

      allow get: if isOwner(userId) || isAdmin();

      allow create: if (
                      isAuthenticated()
                      && userId == request.auth.uid
                      && request.resource.data.uid == request.auth.uid
                      && !request.resource.data.keys().hasAny(["role"])
                    )
                    || (
                      isAdminClaim()
                      && request.resource.data.uid == userId
                    );

      allow update: if
        exists(/databases/$(database)/documents/users/$(userId)) &&
        (
          (
            isOwner(userId)
            && request.resource.data.uid == resource.data.uid
            && roleUnchanged()
          )
          || (
            isAdminClaim()
            && request.resource.data.uid == resource.data.uid
          )
        );

      allow delete: if isAdminClaim();

      // Optional subcollections under /users/{uid}/...
      match /favorites/{favId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update, delete: if isOwner(userId) || isAdmin();
      }

      match /collections/{collectionId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update, delete: if isOwner(userId) || isAdmin();

        match /items/{itemId} {
          allow read: if isOwner(userId) || isAdmin();
          allow create: if isOwner(userId);
          allow update, delete: if isOwner(userId) || isAdmin();
        }
      }
    }

    // ---------------------------
    // PLACES
    // ---------------------------
    match /places/{placeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---------------------------
    // REVIEWS (top-level)
    // ---------------------------
    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid
                    && isTimestamp(request.resource.data.createdAt)
                    && request.resource.data.createdAt <= request.time
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;

      allow update: if
        exists(/databases/$(database)/documents/reviews/$(reviewId)) &&
        (
          (isAdmin())
          || (
            isAuthenticated()
            && resource.data.userId == request.auth.uid
            && request.resource.data.userId == resource.data.userId
          )
        );

      allow delete: if
        exists(/databases/$(database)/documents/reviews/$(reviewId)) &&
        (
          (isAdmin())
          || (
            isAuthenticated()
            && resource.data.userId == request.auth.uid
          )
        );
    }

    // ---------------------------
    // FAVORITES (top-level, if used)
    // ---------------------------
    match /favorites/{favId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;

      allow update, delete: if isAuthenticated()
                            && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ---------------------------
    // COLLECTIONS (top-level, if used)
    // ---------------------------
    match /collections/{collectionId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;

      allow update, delete: if isAuthenticated()
                            && (resource.data.userId == request.auth.uid || isAdmin());

      match /items/{itemId} {
        allow read: if isAuthenticated();

        allow create: if isAuthenticated()
                      && request.resource.data.userId == request.auth.uid;

        allow update, delete: if isAuthenticated()
                              && (resource.data.userId == request.auth.uid || isAdmin());
      }
    }

    // ---------------------------
    // DEFAULT DENY
    // ---------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
