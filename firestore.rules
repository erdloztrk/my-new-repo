rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAuthenticated() {
      return isSignedIn();
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function hasOnlyAllowedFields(allowed) {
      return request.resource.data.keys().hasOnly(allowed);
    }
    
    function isValidRating(rating) {
      return rating is int && rating >= 1 && rating <= 5;
    }
    
    function isValidLatLng() {
      // Accept either latlng (GeoPoint) or {latitude, longitude} map
      return (
        (request.resource.data.coordinates is latlng &&
         request.resource.data.coordinates.latitude >= -90 && 
         request.resource.data.coordinates.latitude <= 90 &&
         request.resource.data.coordinates.longitude >= -180 && 
         request.resource.data.coordinates.longitude <= 180)
        ||
        (request.resource.data.coordinates is map &&
         request.resource.data.coordinates.latitude is number &&
         request.resource.data.coordinates.longitude is number &&
         request.resource.data.coordinates.latitude >= -90 && 
         request.resource.data.coordinates.latitude <= 90 &&
         request.resource.data.coordinates.longitude >= -180 && 
         request.resource.data.coordinates.longitude <= 180)
      );
    }
    
    // Places collection
    // Read: Public (anyone can read)
    // Write: ADMIN ONLY (MVP safe default)
    match /places/{placeId} {
      allow read: if true; // Public read access
      
      // Validation helper
      function validatePlace() {
        let data = request.resource.data;
        // Define allowed fields (adjust based on actual schema)
        let allowedFields = ['name', 'category', 'description', 'address', 'coordinates', 
                            'images', 'createdBy', 'rating', 'reviewCount', 'createdAt', 
                            'updatedAt', 'geohash'];
        return hasOnlyAllowedFields(allowedFields) &&
               data.name is string && 
               data.name.size() > 0 &&
               data.name.size() <= 200 &&
               data.category is string &&
               data.description is string &&
               data.address is string &&
               isValidLatLng() &&
               (data.images == null || (data.images is list && data.images.size() <= 20)) &&
               data.createdBy is string &&
               data.rating is number &&
               data.reviewCount is int &&
               data.createdAt is timestamp;
      }
      
      // ADMIN ONLY for writes (MVP safe default)
      allow create: if isAdmin() && validatePlace();
      allow update: if isAdmin() && validatePlace();
      allow delete: if isAdmin();
    }
    
    // Reviews collection
    // Read: Public
    // Create: Authenticated users only
    // Update/Delete: Only owner
    match /reviews/{reviewId} {
      allow read: if true; // Public read access
      
      allow create: if isAuthenticated() &&
                        request.resource.data.userId == request.auth.uid &&
                        request.resource.data.userName is string &&
                        isValidRating(request.resource.data.rating) &&
                        request.resource.data.comment is string &&
                        request.resource.data.placeId is string &&
                        request.resource.data.createdAt == request.time;
      
      allow update: if isOwner(resource.data.userId) &&
                       // Cannot change userId, placeId, createdAt
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.placeId == resource.data.placeId &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       isValidRating(request.resource.data.rating);
      
      allow delete: if isOwner(resource.data.userId) || isAdmin();
      
      // Rate limiting: Max 1 review per place per user
      // Note: This check is done via query in the app (getReviewsByPlaceId filters by userId)
      // For stricter enforcement, use Cloud Function trigger
    }
    
    // Users collection
    // Read: Own profile or public fields only
    // Write: Own profile only (cannot modify role)
    match /users/{userId} {
      allow read: if isAuthenticated();
      
      allow create: if isAuthenticated() && 
                       request.resource.data.uid == request.auth.uid &&
                       // Role can only be set on creation, not modified later
                       (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      
      allow update: if isOwner(userId) &&
                       // Cannot modify role (admin-only field)
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) &&
                       // Cannot change uid
                       request.resource.data.uid == resource.data.uid;
      
      allow delete: if isOwner(userId) || isAdmin();
    }
    
    // Favorites collection (user's saved places)
    // Read/Write: Own favorites only
    match /favorites/{userId} {
      allow read: if isOwner(userId);
      
      allow write: if isOwner(userId) &&
                      request.resource.data.userId == request.auth.uid &&
                      request.resource.data.placeIds is list;
    }
    
    // Helper function to check if collection can be read
    function canReadCollection(collectionId) {
      let c = get(/databases/$(database)/documents/collections/$(collectionId));
      return (isSignedIn() && c.data.userId == request.auth.uid) || (c.data.isPublic == true);
    }
    
    // Collections/Lists (user-created lists of places)
    // Read: Owner or isPublic == true
    // Write: Owner only
    match /collections/{collectionId} {
      allow read: if canReadCollection(collectionId);
      
      allow create: if isAuthenticated() &&
                        request.resource.data.userId == request.auth.uid &&
                        request.resource.data.name is string &&
                        request.resource.data.name.size() > 0 &&
                        // createdAt should be a timestamp (allow slight time difference)
                        request.resource.data.createdAt is timestamp &&
                        request.resource.data.createdAt <= request.time;
      
      allow update: if isOwner(resource.data.userId) &&
                       // Cannot change userId, createdAt
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.createdAt == resource.data.createdAt;
      
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }
    
    // Collection items (places in a collection)
    match /collections/{collectionId}/items/{itemId} {
      allow read: if canReadCollection(collectionId);
      
      allow write: if isAuthenticated() &&
                      // Check if user owns the parent collection
                      get(/databases/$(database)/documents/collections/$(collectionId)).data.userId == request.auth.uid;
    }
    
    // Admin-only collections (for internal use)
    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }
    
    // Deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

