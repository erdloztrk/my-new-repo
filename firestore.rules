rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isValidRating(rating) {
      return rating is int && rating >= 1 && rating <= 5;
    }
    
    function isValidCoordinates(coords) {
      return coords.latitude is float && 
             coords.longitude is float &&
             coords.latitude >= -90 && coords.latitude <= 90 &&
             coords.longitude >= -180 && coords.longitude <= 180;
    }
    
    // Places collection
    // Read: Public (anyone can read)
    // Write: Only admin or service account
    match /places/{placeId} {
      allow read: if true; // Public read access
      
      allow create: if isAdmin() || 
                       (isAuthenticated() && 
                        request.resource.data.createdBy == request.auth.uid &&
                        request.resource.data.rating == 0 &&
                        request.resource.data.reviewCount == 0);
      
      allow update: if isAdmin() || 
                       (isAuthenticated() && 
                        // Users can only update their own places
                        resource.data.createdBy == request.auth.uid &&
                        // Cannot modify rating/reviewCount directly (aggregated fields)
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rating', 'reviewCount']));
      
      allow delete: if isAdmin();
      
      // Validation
      function validatePlace() {
        let data = request.resource.data;
        return data.name is string && 
               data.name.size() > 0 &&
               data.category is string &&
               data.description is string &&
               data.address is string &&
               isValidCoordinates(data.coordinates) &&
               data.images is list &&
               data.createdBy is string &&
               data.rating is number &&
               data.reviewCount is int &&
               data.createdAt is timestamp;
      }
      
      allow create: if validatePlace();
      allow update: if validatePlace();
    }
    
    // Reviews collection
    // Read: Public
    // Create: Authenticated users only
    // Update/Delete: Only owner
    match /reviews/{reviewId} {
      allow read: if true; // Public read access
      
      allow create: if isAuthenticated() &&
                        request.resource.data.userId == request.auth.uid &&
                        request.resource.data.userName is string &&
                        isValidRating(request.resource.data.rating) &&
                        request.resource.data.comment is string &&
                        request.resource.data.placeId is string &&
                        request.resource.data.createdAt == request.time;
      
      allow update: if isOwner(resource.data.userId) &&
                       // Cannot change userId, placeId, createdAt
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.placeId == resource.data.placeId &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       isValidRating(request.resource.data.rating);
      
      allow delete: if isOwner(resource.data.userId) || isAdmin();
      
      // Rate limiting: Max 1 review per place per user
      // Note: This check is done via query in the app (getReviewsByPlaceId filters by userId)
      // For stricter enforcement, use Cloud Function trigger
    }
    
    // Users collection
    // Read: Own profile or public fields only
    // Write: Own profile only (cannot modify role)
    match /users/{userId} {
      allow read: if isAuthenticated();
      
      allow create: if isAuthenticated() && 
                       request.resource.data.uid == request.auth.uid &&
                       // Role can only be set on creation, not modified later
                       (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      
      allow update: if isOwner(userId) &&
                       // Cannot modify role (admin-only field)
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) &&
                       // Cannot change uid
                       request.resource.data.uid == resource.data.uid;
      
      allow delete: if isOwner(userId) || isAdmin();
    }
    
    // Favorites collection (user's saved places)
    // Read/Write: Own favorites only
    match /favorites/{userId} {
      allow read: if isOwner(userId);
      
      allow write: if isOwner(userId) &&
                      request.resource.data.userId == request.auth.uid &&
                      request.resource.data.placeIds is list;
    }
    
    // Collections/Lists (user-created lists of places)
    // Read: Public (for sharing)
    // Write: Owner only
    match /collections/{collectionId} {
      allow read: if true; // Public read for sharing
      
      allow create: if isAuthenticated() &&
                        request.resource.data.userId == request.auth.uid &&
                        request.resource.data.name is string &&
                        request.resource.data.name.size() > 0 &&
                        request.resource.data.createdAt == request.time;
      
      allow update: if isOwner(resource.data.userId) &&
                       // Cannot change userId, createdAt
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.createdAt == resource.data.createdAt;
      
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }
    
    // Collection items (places in a collection)
    match /collections/{collectionId}/items/{itemId} {
      allow read: if true; // Public read
      
      allow write: if isAuthenticated() &&
                      // Check if user owns the parent collection
                      get(/databases/$(database)/documents/collections/$(collectionId)).data.userId == request.auth.uid;
    }
    
    // Admin-only collections (for internal use)
    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }
    
    // Deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

