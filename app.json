{
  "expo": {
    "name": "LOKAL",
    "slug": "lokal-mvp",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "lokal",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lokal.mvp"
    },
    "android": {
      "package": "com.lokal.mvp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6C63FF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "LOKAL, konumunuzu kullanarak size özel hava durumu bilgisi sunmak için konumunuza erişmek istiyor."
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
