# Expo Environment Variables
# Copy this file to .env and fill in your values

# Firebase Configuration
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# OpenWeather API
EXPO_PUBLIC_OPENWEATHER_KEY=

# OpenRouteService API (for routing)
EXPO_PUBLIC_OPENROUTESERVICE_KEY=

# Backend API URL (for bathymetry/wind services)
# Development: http://localhost:8000 (iOS) or http://10.0.2.2:8000 (Android)
# Production: https://your-backend-domain.com
EXPO_PUBLIC_BATHYMETRY_API_URL=
