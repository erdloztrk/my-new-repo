{
  "name": "lokal-mvp",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "node node_modules/expo/bin/cli start",
    "android": "node node_modules/expo/bin/cli start --android",
    "ios": "node node_modules/expo/bin/cli start --ios",
    "web": "node node_modules/expo/bin/cli start --web",
    "lint": "node node_modules/expo/bin/cli lint",
    "prebuild": "node node_modules/expo/bin/cli prebuild",
    "pod:install": "cd ios && EXPO_USE_COMMUNITY_AUTOLINKING=1 pod install && cd ..",
    "run:ios": "npm run pod:install && EXPO_USE_COMMUNITY_AUTOLINKING=1 node node_modules/expo/bin/cli run:ios"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "^23.7.0",
    "@react-native-firebase/firestore": "^23.7.0",
    "@tabler/icons": "^3.35.0",
    "expo": "~54.0.27",
    "expo-asset": "~12.0.10",
    "expo-constants": "~18.0.10",
    "expo-font": "~14.0.9",
    "expo-image-picker": "^17.0.9",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.9",
    "expo-localization": "~17.0.8",
    "expo-location": "~19.0.7",
    "expo-maps": "~0.12.9",
    "expo-router": "~6.0.16",
    "expo-status-bar": "~3.0.8",
    "firebase": "^12.6.0",
    "nativewind": "^4.2.1",
    "phosphor-react-native": "^3.0.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native-community/cli": "^20.0.2",
    "@types/react": "~19.1.10",
    "@types/react-native": "^0.73.0",
    "babel-preset-expo": "~54.0.7",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.9.2"
  },
  "private": true
